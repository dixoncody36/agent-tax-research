{
  "name": "@agent-tax-research/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:prepare": "tsx src/prepare.ts",
    "db:migrate": "tsx src/prepare.ts && drizzle-kit migrate",
    "db:seed": "tsx src/seed.ts",
    "db:seed:federal": "tsx src/seed-federal.ts",
    "db:seed:products": "tsx src/seed-products.ts",
    "db:seed:canada": "tsx src/seed-canada.ts",
    "db:seed:kansas": "tsx src/seed-kansas.ts",
    "db:studio": "drizzle-kit studio",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
