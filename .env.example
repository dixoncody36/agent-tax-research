# Copy to .env for local development. Never commit .env with real secrets.
# Local container defaults (docker-compose.yml) — dev only.

# Postgres container
POSTGRES_DB=agent_tax_research
POSTGRES_USER=tax
POSTGRES_PASSWORD=tax_dev_only
DB_PORT=5433

# App / Drizzle connection string (host port must match DB_PORT)
DATABASE_URL=postgres://tax:tax_dev_only@localhost:5433/agent_tax_research

# Azure AI Foundry (optional: headless role runners + embeddings).
# Role -> model/deployment mapping lives in config/models.yaml.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_EMBEDDING_DEPLOYMENT=

# Meta Model API / Muse (hackathon provider). Create a key at
# https://dev.meta.ai — format LLM|<id>|<secret>. Put the real key in
# .env.local (gitignored), never here. See docs/model-apis.md.
MODEL_API_KEY=
META_MODEL_API_BASE=https://api.meta.ai/v1
# Spend guardrail measured against recorded Muse-API agent_runs.
MUSE_BUDGET_USD=150
# Optional rate card from your Meta console (USD per 1M tokens). When
# unset, runs record tokens with cost_usd null and budget shows tokens.
MUSE_INPUT_USD_PER_MTOK=
MUSE_OUTPUT_USD_PER_MTOK=

# Claude API (Anthropic) for headless role runs — pnpm model:api / model:loop
# with anthropic:<model>. Real key in .env.local only. See docs/model-apis.md.
ANTHROPIC_API_KEY=
# Optional spend ceiling for recorded Claude API runs (unset = loop caps only).
ANTHROPIC_BUDGET_USD=

# OpenRouter for headless role runs — openrouter:<vendor/model>. Real key in
# .env.local only. Billed cost comes back on each response.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Used when a run names the openrouter provider but no model.
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_BUDGET_USD=
