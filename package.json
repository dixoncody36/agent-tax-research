{
  "name": "agent-tax-research",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @agent-tax-research/database db:generate",
    "db:migrate": "pnpm --filter @agent-tax-research/database db:migrate",
    "db:seed": "pnpm --filter @agent-tax-research/database db:seed",
    "db:studio": "pnpm --filter @agent-tax-research/database db:studio",
    "tax": "pnpm --filter @agent-tax-research/cli exec tsx src/tax.ts",
    "audit:pack": "pnpm --filter @agent-tax-research/cli exec tsx src/audit-pack.ts",
    "guide": "pnpm --filter @agent-tax-research/cli exec tsx src/guide.ts",
    "analytics:export": "pnpm --filter @agent-tax-research/cli exec tsx src/analytics-export.ts",
    "muse:api": "pnpm --filter @agent-tax-research/cli exec tsx src/muse-api.ts",
    "muse:loop": "pnpm --filter @agent-tax-research/cli exec tsx src/muse-loop.ts",
    "products": "pnpm --filter @agent-tax-research/cli exec tsx src/products.ts",
    "web:build": "pnpm --filter @agent-tax-research/web run build",
    "web:start": "pnpm --filter @agent-tax-research/web run start",
    "web:dev": "pnpm --filter @agent-tax-research/web run dev",
    "typecheck": "pnpm --filter @agent-tax-research/database typecheck && pnpm --filter @agent-tax-research/cli run typecheck && pnpm --filter @agent-tax-research/web run typecheck"
  }
}
